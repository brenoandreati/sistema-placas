# Conexão usada pela aplicação em tempo de execução.
DATABASE_URL="postgresql://placas:placas@localhost:5432/placas_dev"

# (Opcional) Conexão com privilégios de dono do schema, usada apenas pelas migrations.
# Se omitida, DATABASE_URL é usada.
# MIGRATION_DATABASE_URL="postgresql://placas_owner:senha@localhost:5432/placas_dev"

# Banco usado pelos testes automatizados (será limpo a cada execução!).
TEST_DATABASE_URL="postgresql://placas:placas@localhost:5432/placas_test"

# Administrador inicial criado pelo seed (npm run db:seed). Troque a senha após o primeiro acesso.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha-forte"

# Duração da sessão em horas (padrão: 12).
SESSION_TTL_HOURS="12"
